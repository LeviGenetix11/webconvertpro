{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "redirects": [
    { "source": "/website-design", "destination": "/web-design/", "permanent": true },
    { "source": "/website-in-a-day/", "destination": "/starter/", "permanent": true },
    { "source": "/website-in-a-day", "destination": "/starter/", "permanent": true },
    { "source": "/thank-you/website-preview", "destination": "/preview/thanks/", "permanent": false },
    { "source": "/thank-you/website-audit", "destination": "/free-website-audit/thanks/", "permanent": false },
    { "source": "/thank-you/local-seo", "destination": "/local-seo-audit/thanks/", "permanent": false },
    { "source": "/thank-you/directory-scan", "destination": "/directory-scan/thanks/", "permanent": false },
    { "source": "/thank-you/branding", "destination": "/branding-preview/thanks/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
