<script>
(function () {
  var params = new URLSearchParams(window.location.search);
  var keys = ["utm_source", "utm_medium", "utm_campaign", "utm_content"];
  var stored = {};
  try {
    keys.forEach(function (k) {
      var v = params.get(k);
      if (v) sessionStorage.setItem(k, v);
      stored[k] = sessionStorage.getItem(k) || "";
    });
    if (!sessionStorage.getItem("referrer") && document.referrer) sessionStorage.setItem("referrer", document.referrer);
    if (!sessionStorage.getItem("landing_page")) sessionStorage.setItem("landing_page", window.location.pathname);
    stored.referrer = sessionStorage.getItem("referrer") || "";
    stored.landing_page = sessionStorage.getItem("landing_page") || "";
  } catch (e) {
    stored = { utm_source: "", utm_medium: "", utm_campaign: "", utm_content: "", referrer: "", landing_page: "" };
  }

  Object.keys(stored).forEach(function (k) {
    var field = document.querySelector('#preview-form [name="' + k + '"]');
    if (field) field.value = stored[k];
  });

  function track(name) {
    if (typeof gtag !== "function") return;
    gtag("event", name, { utm_source: stored.utm_source || "" });
  }

  var cta = document.getElementById("preview-cta");
  if (cta) cta.addEventListener("click", function () { track("preview_cta_click"); });

  var form = document.getElementById("preview-form");
  if (form) {
    var started = false;
    form.addEventListener("focusin", function () {
      if (!started) { started = true; track("preview_form_start"); }
    });
    form.addEventListener("submit", function () { track("preview_form_submit"); });
  }
})();
</script>
