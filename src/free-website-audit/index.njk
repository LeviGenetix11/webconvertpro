      <p class="hidden"><label>Leave this empty <input name="_gotcha"></label></p>
    {%- else %}
    <form class="form" data-lead-form="website_audit" name="website-audit" method="POST" action="/free-website-audit/thanks/" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="website-audit">
      <input type="hidden" name="offer" value="website-audit">
      {%- include "partials/lead-attribution-fields.njk" %}
      <p class="fine full">Fields marked <span class="req" aria-hidden="true">*</span> are required.</p>
      <p class="hidden"><label>Leave this empty <input name="bot-field"></label></p>
    {%- endif %}
      <div class="full"><label for="wa-url">Website URL <span class="req" aria-hidden="true">*</span></label><input id="wa-url" name="website" inputmode="url" placeholder="yourbusiness.ca" required aria-required="true"></div>
      <div><label for="wa-business">Business name <span class="req" aria-hidden="true">*</span></label><input id="wa-business" name="business" autocomplete="organization" required aria-required="true"></div>
      <div><label for="wa-name">Your name <span class="req" aria-hidden="true">*</span></label><input id="wa-name" name="name" autocomplete="name" required aria-required="true"></div>
      <div><label for="wa-email">Email <span class="req" aria-hidden="true">*</span></label><input id="wa-email" type="email" name="email" autocomplete="email" required aria-required="true"></div>
      <div><label for="wa-phone">Phone <span>(optional)</span></label><input id="wa-phone" type="tel" name="phone" autocomplete="tel"></div>
      <div class="full"><label for="wa-concern">What concerns you most about your current website? <span>(optional)</span></label><textarea id="wa-concern" name="concern" placeholder="e.g. it doesn't look professional, I don't get enquiries, it's slow on mobile"></textarea></div>
      <div class="full"><button class="btn btn--primary" type="submit">Get my free website audit</button></div>
      <p class="fine full">We use your details only to send your audit and follow up about it. See our <a href="/privacy/">privacy policy</a>.</p>
    </form>
  </div>
</section>

