<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="{{ site.name }} home"><img src="/assets/img/logo.png" alt="{{ site.name }}" width="475" height="146"></a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
    </button>
    <nav class="nav" id="site-nav" aria-label="Main">
      {%- for item in site.nav %}
      <a href="{{ item.href }}"{% if nav == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
      {% if site.calendarUrl %}<a class="btn btn--primary" href="{{ site.calendarUrl }}">Book a free audit</a>{% else %}<a class="btn btn--primary" href="/contact/">Get my free preview</a>{% endif %}
    </nav>
  </div>
</header>
