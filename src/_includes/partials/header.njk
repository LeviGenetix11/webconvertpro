<a class="skip" href="#main">Skip to content</a>
<header class="site-header{% if minimalHeader %} site-header--minimal{% endif %}">
  <div class="wrap">
    <a class="logo" href="/" aria-label="{{ site.name }} home"><img src="/assets/img/logo.png" alt="{{ site.name }}" width="475" height="146"></a>
    <div class="header-right">
      <a class="header-call" id="header-call" href="tel:{{ site.phone }}" aria-label="Call {{ site.name }}, {{ site.phoneDisplay }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </a>
      {%- if not minimalHeader %}
      <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
      </button>
      {%- endif %}
    </div>
    {%- if not minimalHeader %}
    <nav class="nav" id="site-nav" aria-label="Main">
      {%- for item in site.nav %}
      <a href="{{ item.href }}"{% if nav == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
      {% if site.calendarUrl %}<a class="btn btn--primary" href="{{ site.calendarUrl }}">Book a free audit</a>{% else %}<a class="btn btn--primary" href="/contact/">Get my free preview</a>{% endif %}
    </nav>
    {%- endif %}
  </div>
</header>
